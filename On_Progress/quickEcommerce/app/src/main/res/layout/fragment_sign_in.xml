<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".auth.SignInFragment"
    android:background="@android:color/transparent"
    >

    <!-- Top 50%: Product carousel animations -->
    <LinearLayout
            android:id="@+id/top_half"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_half"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- all your HorizontalScrollViews go here -->

            <!-- Row 1: 4 products scrolling left to right (fast, assume rightward content movement) -->
            <HorizontalScrollView
                android:id="@+id/row1_scroll"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:overScrollMode="never"
                android:scrollbars="none"

                >

                <LinearLayout
                    android:id="@+id/row1_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="0dp"
                    >
                    <!-- First set of 4 products -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/amulic1" />

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/corneto1" />

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/attta1" />

                    </FrameLayout>


                    <!-- Duplicate set for seamless loop -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/tea" />

                    </FrameLayout>


                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 2: Other 4 products scrolling right to left (fast, opposite direction) -->
            <HorizontalScrollView
                android:id="@+id/row2_scroll"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:overScrollMode="never"

                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row2_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="45dp"
                    >
                    <!-- First set -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/magggi1" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/organic_premium" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/milma_milk" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/instant" />

                    </FrameLayout>
                    <!-- Duplicate set -->

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 3: Same as row 1 but slow speed -->
            <HorizontalScrollView
                android:id="@+id/row3_scroll"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:overScrollMode="never"

                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row3_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <!-- Same as row 1 -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/baby" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/home_office" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/munchies" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/pet_care" />

                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 4: Same as row 2 but slow speed, opposite to row 3 -->
            <HorizontalScrollView
                android:id="@+id/row4_scroll"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row4_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="45dp"
                    >
                    <!-- Same as row 2 -->
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/dairy_breakfast" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/cold_and_juices" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/sauce_spreads" />

                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/square_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/cleaning" />

                    </FrameLayout>


                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

    <View
        android:id="@+id/bright_line"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/fade_top_gradient"
        app:layout_constraintTop_toBottomOf="@id/top_half"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_half"/>


    <!-- Bottom 50%: Login/Signup by phone -->
    <ScrollView
            android:id="@+id/bottom_half"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:background="@drawable/bg_bottom_shit"
            app:layout_constraintTop_toBottomOf="@id/bright_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                >

                <!-- your login icon, title, phone_input, continue_button -->

                <!-- Thin bright line at the top (optional - enhances separation) -->

                <ImageView
                    android:id="@+id/ivAppIconLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="13.00dp"
                    android:src="@drawable/app_icon"/>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13.00dp"
                    android:text="Login or Signup"
                    android:textSize="24sp"
                    android:textStyle="normal"
                    app:layout_constraintTop_toBottomOf="@id/ivAppIconLogin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/phone_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Enter phone number"
                    android:inputType="phone"
                    android:textSize="18sp"
                    app:layout_constraintTop_toBottomOf="@id/title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="32dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continue_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Continue"
                    android:backgroundTint="@color/grayish_blue"
                    android:textColor="#FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/phone_input"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>