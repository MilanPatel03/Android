<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false"
    tools:context=".auth.SplashFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >

            <TextView
                android:id="@+id/tvBlink"
                android:layout_width="wrap_content"
                android:layout_height="90.00dp"
                android:textColor="@color/black"
                android:text="blink"
                android:textSize="78.00sp"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/tvIt"
                android:layout_width="wrap_content"
                android:layout_height="90.00dp"
                android:textColor="@color/green"
                android:text="it"
                android:textSize="78.00sp"
                android:textStyle="bold"
                />
            
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="India's last minute app"
            android:textSize="19.50sp"
            android:textColor="@color/black">
        </TextView>
        
        <View
            android:layout_width="234.00dp"
            android:layout_height="2.60dp"
            android:background="#7B7777"
            android:layout_weight="3"
            android:layout_marginTop="26.00dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A ZOMATO COMPANY"
            android:textSize="10.40sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="26.00dp">
        </TextView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>