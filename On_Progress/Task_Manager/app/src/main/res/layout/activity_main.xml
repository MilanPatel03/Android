<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity">

    <!-- APP_BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout_home"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOOL_BAR -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_home"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/home_page_title"
            >

            <ImageView
                android:id="@+id/account_image"
                android:src="@drawable/rounded_account_circle_24"
                android:layout_width="30dp"
                android:layout_height="30dp"

                android:layout_gravity="end"
                android:layout_marginEnd="15dp" >
            </ImageView>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- TABS -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!--VIEW_PAGER2-->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_home"
        app:layout_constraintTop_toBottomOf="@id/appbar_layout_home"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <!-- FRAGMENT CONTAINER -->
<!--    <androidx.fragment.app.FragmentContainerView-->
<!--        android:id="@+id/fragment_container"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="0dp"-->
<!--        app:layout_constraintTop_toBottomOf="@id/appbar_layout_home"-->
<!--        app:layout_constraintBottom_toBottomOf="parent" />-->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_task_button"
        android:contentDescription="@string/todo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/outline_add_2_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>